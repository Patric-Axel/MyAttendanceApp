<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvFechaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="19/05/2025"
            android:textColor="@color/azul_oscuro"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvEstadoItem"/>

        <!-- Badge Estado -->
        <TextView
            android:id="@+id/tvEstadoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completo"
            android:textColor="@color/azul_oscuro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_estado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Línea divisora -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fucsia_claro"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvFechaItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Entrada -->
        <LinearLayout
            android:id="@+id/llEntrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/llSalida">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hora_entrada"
                android:textColor="@color/azul"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvHoraEntradaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:15 a.m."
                android:textColor="@color/azul_oscuro"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Salida -->
        <LinearLayout
            android:id="@+id/llSalida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toEndOf="@id/llEntrada"
            app:layout_constraintEnd_toStartOf="@id/llHoras">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hora_salida"
                android:textColor="@color/azul"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvHoraSalidaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:10 p.m."
                android:textColor="@color/azul_oscuro"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Horas trabajadas -->
        <LinearLayout
            android:id="@+id/llHoras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/horas_trabajadas"
                android:textColor="@color/azul"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvHorasItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:55"
                android:textColor="@color/azul_oscuro"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>